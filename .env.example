ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3000

# Password users must enter to access the app (required before sharing)
ACCESS_PASSWORD=change-me-before-sharing

# Max tokens served per day across all users (100k ≈ $0.30–0.45/day)
DAILY_TOKEN_BUDGET=100000

# Tavily API key for live web search (get free at app.tavily.com)
# Without this, scholarship search falls back to AI-only mode
TAVILY_API_KEY=tvly-your-key-here

# Max Tavily API calls per day (150 = ~50 scholarship searches × 3 queries each)
DAILY_SEARCH_CALLS=150

# Max Tavily calls per day for the College Assessment tab (separate budget)
# 60 = ~10 college assessments × 6 colleges each
DAILY_COLLEGE_CALLS=60
